{
    "name": "core45/system-settings-db",
    "description": "Get system settings for your Laravel app from database",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Core45\\SystemSettingsDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Core45\\SystemSettingsDb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Core45\\SystemSettingsDb\\SystemSettingsDBServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Kornel Kornecki",
            "email": "kornel@core45.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
